<%# locals: (activation:) %>
<article class="duty-card<%= " duty-card--warn" if activation.warning_codes.any? %><%= " is-new" if !activation.completed? && activation.activated_at > 20.seconds.ago %><%= " duty-card--done" if activation.completed? %>" id="<%= dom_id(activation) %>">
  <header class="duty-card__head">
    <span class="duty-card__slot"><%= activation.slot_label %></span>
    <%= activation_status_badge(activation) %>
  </header>
  <h3 class="duty-card__title"><%= link_to activation.label, duty_activation_path(activation) %></h3>
  <p class="duty-card__meta">Menggantikan <%= activation.absence.teacher.name %> (<%= activation.absence.reason_label %>)</p>
  <% if activation.kit %>
    <p class="duty-card__kit"><strong><%= activation.kit.title %></strong> · <%= activation.kit.duration_minutes %> menit
      <% if activation.reused %><span class="badge">Pakai ulang</span><% end %></p>
  <% else %>
    <p class="duty-card__kit"><span class="badge badge--warn">Mode cadangan</span> Tugas mandiri umum</p>
  <% end %>
  <% if activation.warning_codes.any? %>
    <ul class="note-list"><% activation.warnings.each do |w| %><li><%= w %></li><% end %></ul>
  <% end %>
  <footer><%= link_to (activation.completed? ? "Lihat hasil" : "Buka kit"), duty_activation_path(activation), class: "btn #{activation.completed? ? "btn--secondary" : "btn--primary"} btn--sm" %></footer>
</article>
