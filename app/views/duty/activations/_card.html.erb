<%# locals: (activation:) %>
<article class="ticket duty-card<%= " duty-card--warn" if activation.warning_codes.any? && !activation.completed? %><%= " is-new" if !activation.completed? && activation.activated_at > 20.seconds.ago %><%= " duty-card--done" if activation.completed? %>" id="<%= dom_id(activation) %>">
  <div class="ticket__stub">
    <span class="ticket__label">Jam ke</span>
    <span class="ticket__no"><%= activation.period.number %></span>
    <span class="ticket__time"><%= activation.period.time_range %></span>
  </div>
  <div class="ticket__body">
    <header class="duty-card__head">
      <span class="duty-card__slot"><%= activation.slot_label %></span>
      <%= activation_status_badge(activation) %>
    </header>
    <h3 class="duty-card__title"><%= link_to activation.label, duty_activation_path(activation) %></h3>
    <p class="duty-card__meta">Menggantikan <%= activation.absence.teacher.name %> (<%= activation.absence.reason_label %>)</p>
    <% if activation.kit %>
      <p class="duty-card__kit"><strong><%= activation.kit.title %></strong><span class="muted"><%= activation.kit.duration_minutes %> menit</span>
        <% if activation.reused %><span class="badge">Pakai ulang</span><% end %></p>
    <% else %>
      <p class="duty-card__kit"><span class="badge badge--warn">Mode cadangan</span> Tugas mandiri umum</p>
    <% end %>
    <% if activation.warning_codes.any? && !activation.completed? %>
      <ul class="note-list"><% activation.warnings.each do |w| %><li><%= w %></li><% end %></ul>
    <% end %>
    <div class="duty-card__action"><%= link_to (activation.completed? ? "Lihat hasil" : "Buka kit"), duty_activation_path(activation), class: "btn #{activation.completed? ? "btn--secondary" : "btn--primary"} btn--sm" %></div>
  </div>
</article>
