<%# locals: (activations:) %>
<div id="duty-activations" class="live-region" data-controller="live-title" data-live-title-count-value="<%= activations.count { |a| !a.completed? } %>">
  <% if activations.empty? %>
    <%= render "shared/empty_state", title: "Belum ada kit aktif", body: "Saat ada kelas kosong, slip kit muncul otomatis di sini." %>
  <% else %>
    <% activations.group_by(&:date).each do |date, rows| %>
      <section class="day-group" aria-label="<%= date_heading(date) %>">
        <h2 class="day-group__title"><%= date_heading(date) %></h2>
        <div class="duty-grid"><%= render partial: "duty/activations/card", collection: rows, as: :activation %></div>
      </section>
    <% end %>
  <% end %>
</div>
