<% content_for :title, @activation.label %>
<div class="page-head page-head--row">
  <div>
    <p class="crumb"><%= link_to duty_root_path do %><%= icon("arrow-left", size: 16) %>Kit Hari Ini<% end %></p>
    <h1><%= @activation.label %></h1>
    <p class="page-head__sub"><%= date_heading(@activation.date) %> · <%= @activation.slot_label %> · Menggantikan <%= @activation.absence.teacher.name %> (<%= @activation.absence.reason_label %>)</p>
  </div>
  <%= activation_status_badge(@activation) %>
</div>

<% if @activation.warning_codes.any? %>
  <div class="alert alert--warn" role="status"><%= icon("alert") %><div class="alert__body"><ul class="alert__list"><% @activation.warnings.each do |w| %><li><%= w %></li><% end %></ul></div></div>
<% end %>

<% if @activation.kit %>
  <% kit = @activation.kit %>
  <div class="kit-detail">
    <section class="card">
      <h2 class="card__title">Petunjuk untuk pengawas</h2>
      <p><strong><%= kit.title %></strong> · <%= kit.duration_minutes %> menit<% if @activation.reused %> <span class="badge">Pakai ulang</span><% end %></p>
      <p class="prewrap"><%= kit.supervisor_instructions %></p>
    </section>
    <section class="card">
      <h2 class="card__title">Lembar soal</h2>
      <% if kit.worksheet.attached? %>
        <p><%= link_to worksheet_duty_activation_path(@activation), class: "btn btn--secondary" do %><%= icon("download", size: 18) %>Unduh <%= kit.worksheet.filename %><% end %></p>
      <% else %>
        <p class="muted">Tidak ada lampiran PDF. Ikuti petunjuk di samping.</p>
      <% end %>
      <details class="answer-key">
        <summary>Kunci jawaban (untuk memeriksa hasil)</summary>
        <p class="prewrap"><%= kit.answer_key.presence || "Belum diisi oleh guru." %></p>
      </details>
    </section>
  </div>
<% else %>
  <section class="card">
    <h2 class="card__title">Mode cadangan: tugas mandiri umum</h2>
    <p class="muted">Guru belum menyiapkan kit untuk kelas ini. Gunakan langkah berikut supaya jam ini tetap terpakai belajar.</p>
    <ol class="steps">
      <li>Pastikan semua siswa duduk tenang. Catat kehadiran di aplikasi.</li>
      <li>Minta siswa membuka buku catatan mapel <strong><%= @activation.subject.name %></strong> dan membaca materi terakhir.</li>
      <li>Siswa merangkum materi dalam 5 kalimat dan menulis 3 pertanyaan tentang materi itu.</li>
      <li>Kumpulkan hasil di akhir jam dan serahkan ke guru mapel.</li>
    </ol>
  </section>
<% end %>

<section class="card sheets" aria-labelledby="sheets-title">
  <div class="sheets__head">
    <h2 id="sheets-title" class="card__title">Lembar kehadiran dan pengumpulan</h2>
    <%= render "duty/activations/summary", summary: @summary %>
  </div>

  <% if @attendance.empty? %>
    <p class="muted">Kelas ini belum punya data siswa, jadi lembar tidak bisa diisi.</p>
  <% else %>
    <% if @activation.completed? %>
      <p class="muted">Aktivasi sudah diselesaikan, jadi lembar hanya bisa dibaca.</p>
    <% else %>
      <p class="muted">Perubahan tersimpan otomatis per siswa.</p>
    <% end %>
    <div class="sheets__cols">
      <div>
        <h3 class="sheets__title">Kehadiran</h3>
        <ul class="sheet-list"><% @attendance.each do |record| %><li><%= render "duty/sheets/attendance_row", activation: @activation, record: record %></li><% end %></ul>
      </div>
      <div>
        <h3 class="sheets__title">Pengumpulan</h3>
        <ul class="sheet-list"><% @submissions.each do |record| %><li><%= render "duty/sheets/submission_row", activation: @activation, record: record %></li><% end %></ul>
      </div>
    </div>
  <% end %>
</section>

<% if @activation.completed? %>
  <div class="alert alert--ok" role="status"><%= icon("check") %><div class="alert__body">Selesai pada <%= l(@activation.completed_at, format: :long) %>. Hasil sudah dikirim ke <%= @activation.absence.teacher.name %>.</div></div>
<% else %>
  <div class="finish">
    <%= button_to complete_duty_activation_path(@activation), method: :patch, class: "btn btn--primary btn--lg",
          form: { data: { turbo_confirm: "Selesaikan jam ini? Setelah itu lembar tidak bisa diubah dan kit ditandai terpakai." } }, data: { turbo_submits_with: "Menyimpan..." } do %><%= icon("check", size: 20) %>Selesai dan kirim hasil ke guru<% end %>
  </div>
<% end %>
