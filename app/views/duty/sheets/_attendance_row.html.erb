<%# locals: (activation:, record:) %>
<%= turbo_frame_tag dom_id(record), class: "sheet-row" do %>
  <% name = "#{record.student.roll_number}. #{record.student.name}" %>
  <% if activation.completed? %>
    <span class="sheet-row__name"><%= name %></span>
    <span class="badge badge--status-<%= record.hadir? ? "aktif" : "warn" %>"><%= AttendanceRecord::STATUS_LABELS.fetch(record.status) %></span>
  <% else %>
    <%= form_with url: duty_activation_attendance_record_path(activation, record), method: :patch, class: "sheet-form", data: { controller: "autosave" } do %>
      <span class="sheet-row__name"><%= name %></span>
      <fieldset class="seg">
        <legend class="sr-only">Kehadiran <%= name %></legend>
        <% AttendanceRecord::STATUS_LABELS.each do |value, label| %>
          <label class="seg__opt"><%= radio_button_tag "attendance_record[status]", value, record.status == value, id: "#{dom_id(record)}_#{value}", data: { action: "autosave#submit" } %><span><%= label %></span></label>
        <% end %>
      </fieldset>
      <% if record.saved_changes.except("updated_at").any? %><span class="saved-tick" role="status"><%= icon("check", size: 18) %><span class="sr-only">Tersimpan</span></span><% end %>
      <noscript><button type="submit" class="btn btn--secondary btn--sm">Simpan</button></noscript>
      <% record.errors.full_messages.each do |m| %><small class="sheet-row__error" role="alert"><%= m %></small><% end %>
    <% end %>
  <% end %>
<% end %>
