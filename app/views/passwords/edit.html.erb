<% content_for :title, "Atur ulang kata sandi" %>
<% content_for :main_class, "auth" %>
<section class="auth__panel">
  <div class="card auth__card">
    <h1 class="auth__title">Atur ulang kata sandi</h1>
    <%= form_with url: password_path(params[:token]), method: :put, class: "form" do |form| %>
      <div class="field">
        <%= form.label :password, "Kata sandi baru" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, "Ulangi kata sandi baru" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
      </div>
      <%= form.submit "Simpan", class: "btn btn--primary btn--block" %>
    <% end %>
  </div>
</section>
