<% content_for :title, "Lupa kata sandi" %>
<% content_for :main_class, "auth" %>
<section class="auth__panel">
  <div class="card auth__card">
    <h1 class="auth__title">Lupa kata sandi?</h1>
    <%= form_with url: passwords_path, class: "form" do |form| %>
      <div class="field">
        <%= form.label :email_address, "Email" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
      </div>
      <%= form.submit "Kirim petunjuk", class: "btn btn--primary btn--block" %>
    <% end %>
    <%= link_to "Kembali ke halaman masuk", new_session_path, class: "auth__link" %>
  </div>
</section>
