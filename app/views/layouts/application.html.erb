<!DOCTYPE html>
<html lang="id">
  <head>
    <%# Copyright (c) 2026 Vassel Goleyu. All rights reserved. %>
    <title><%= [ content_for(:title), "Siaga Kelas" ].compact_blank.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Siaga Kelas">
    <meta name="description" content="Siaga Kelas: jam kosong bukan lagi jam bebas.">
    <meta name="author" content="Vassel Goleyu">
    <meta name="copyright" content="Vassel Goleyu">
    <meta name="theme-color" content="#0a1236">
    <meta name="color-scheme" content="light dark">
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="preload" href="<%= asset_path("plus-jakarta-sans-latin-wght-normal.woff2") %>" as="font" type="font/woff2" crossorigin>

    <%# Memuat semua stylesheet di app/assets/stylesheets (urutan lapisan diatur di 00_layers.css) %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= authenticated? ? "app" : "guest" %>">
    <a class="skip-link" href="#main">Lewati ke konten utama</a>
    <%= render "shared/header" if authenticated? %>
    <div id="toasts" class="toasts" role="status" aria-live="polite"></div>

    <main id="main" class="<%= content_for?(:main_class) ? yield(:main_class) : "container" %>">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <small>© 2026 Vassel Goleyu · Siaga Kelas, <em>jam kosong bukan lagi jam bebas.</em></small>
    </footer>
  </body>
</html>
