<% if flash[:alert] %>
  <div class="alert alert--danger" role="alert"><%= flash[:alert] %></div>
<% end %>
<% if flash[:notice] %>
  <div class="alert alert--ok" role="status"><%= flash[:notice] %></div>
<% end %>
<% if flash[:warnings].present? %>
  <div class="alert alert--warn" role="status">
    <strong>Perlu perhatian:</strong>
    <ul class="alert__list"><% Array(flash[:warnings]).each do |warning| %><li><%= warning %></li><% end %></ul>
  </div>
<% end %>
