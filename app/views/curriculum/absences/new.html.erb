<% content_for :title, "Tandai Guru Berhalangan" %>
<div class="page-head">
  <p class="crumb"><%= link_to "← Jam Kosong", curriculum_root_path %></p>
  <h1>Tandai Guru Berhalangan</h1>
  <p class="page-head__sub">Pilih guru dan tanggal, lihat dampaknya, lalu aktifkan kit siaga dengan satu tombol.</p>
</div>

<div class="card card--form">
  <%= form_with url: new_curriculum_absence_path, method: :get, class: "form", data: { turbo_frame: "preview", turbo_action: "advance" } do |form| %>
    <div class="field"><%= form.label :teacher_id, "Guru yang berhalangan" %>
      <%= form.select :teacher_id, @teachers.map { |t| [ t.name, t.id ] }, { include_blank: "Pilih guru", selected: @teacher&.id }, required: true %></div>
    <div class="field-row">
      <div class="field"><%= form.label :date, "Tanggal" %>
        <%= form.date_field :date, required: true, value: @date, min: Date.current, max: Date.current + Activations::Create::WINDOW_DAYS %>
        <small class="field__hint">Hari ini sampai <%= Activations::Create::WINDOW_DAYS %> hari ke depan.</small></div>
      <div class="field"><%= form.label :reason, "Alasan" %>
        <%= form.select :reason, Absence::REASONS.map { |k, v| [ v, k ] }, { selected: @reason } %></div>
    </div>
    <div class="field"><%= form.label :note, "Catatan (opsional)" %>
      <%= form.text_field :note, value: @note, maxlength: 200 %></div>
    <div class="form-actions"><%= form.submit "Lihat dampak", class: "btn btn--secondary" %></div>
  <% end %>
</div>

<%= turbo_frame_tag "preview", data: { turbo_action: "advance" } do %>
  <%= render "curriculum/absences/preview" %>
<% end %>
