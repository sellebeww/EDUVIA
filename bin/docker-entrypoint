# Menyiapkan database dan data demo sebelum menjalankan perintah utama.
set -e

rm -f tmp/pids/server.pid

# Hanya untuk perintah server: siapkan DB dan seed (idempoten).
if [ "$2" == "server" ]; then
  bin/rails db:prepare
  bin/rails db:seed
fi

exec "$@"
